#!/bin/sh

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
unsigned=''

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue

	if [ "$remote_sha" = "$zero" ]; then
		range="$local_sha --not --remotes"
	else
		range="$remote_sha..$local_sha"
	fi

	for sha in $(git rev-list $range); do
		if ! git cat-file commit "$sha" | sed -n '/^$/q;p' | grep -q '^gpgsig'; then
			unsigned="$unsigned $sha"
		fi
	done
done

unsigned=$(echo $unsigned)
[ -z "$unsigned" ] && exit 0

echo >&2
echo "  Push rejected: unsigned commits" >&2
echo >&2
for sha in $unsigned; do
	git --no-pager log -1 --format='    %h  %s' "$sha" >&2
done
echo >&2
echo "  Every commit in this repository must be signed." >&2
echo >&2
echo "  Sign them, then push again:" >&2
echo >&2
echo "    git config commit.gpgsign true" >&2
echo "    git rebase --exec 'git commit --amend --no-edit -S' origin/main" >&2
echo >&2

exit 1
